<%- include('../partials/public-header') %>

<section class="section-tight">
  <div class="container">
    <span class="eyebrow">साहित्य</span>
    <h1><%= pageTitle %></h1>
    <% if (typeof subtitle !== 'undefined' && subtitle) { %><p class="muted" style="max-width:65ch;"><%= subtitle %></p><% } %>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="filter-bar">
      <form method="get" action="<%= basePath %>">
        <label class="sr-only" for="filter-q">शोध</label>
        <input class="input search-input" id="filter-q" type="search" name="q" value="<%= filters.q %>" placeholder="शीर्षक किंवा मजकुरात शोधा…">

        <% if (!fixedType) { %>
        <label class="sr-only" for="filter-type">प्रकार</label>
        <select class="select" id="filter-type" name="type">
          <option value="">सर्व प्रकार</option>
          <option value="article" <%= filters.type === 'article' ? 'selected' : '' %>>लेख</option>
          <option value="poem" <%= filters.type === 'poem' ? 'selected' : '' %>>कविता</option>
          <option value="ghazal" <%= filters.type === 'ghazal' ? 'selected' : '' %>>गझल</option>
          <option value="story" <%= filters.type === 'story' ? 'selected' : '' %>>कथा</option>
        </select>
        <% } %>

        <label class="sr-only" for="filter-category">विभाग</label>
        <select class="select" id="filter-category" name="category">
          <option value="">सर्व विभाग</option>
          <% categories.forEach(function (category) { %>
            <option value="<%= category.slug %>" <%= filters.category === category.slug ? 'selected' : '' %>><%= category.name_mr %></option>
          <% }) %>
        </select>

        <label class="sr-only" for="filter-language">भाषा</label>
        <select class="select" id="filter-language" name="language">
          <option value="">सर्व भाषा</option>
          <option value="mr" <%= filters.language === 'mr' ? 'selected' : '' %>>मराठी</option>
          <option value="ahr" <%= filters.language === 'ahr' ? 'selected' : '' %>>अहिराणी</option>
          <option value="hi" <%= filters.language === 'hi' ? 'selected' : '' %>>हिंदी</option>
          <option value="en" <%= filters.language === 'en' ? 'selected' : '' %>>इंग्रजी</option>
        </select>

        <label class="sr-only" for="filter-sort">क्रम</label>
        <select class="select" id="filter-sort" name="sort">
          <option value="latest" <%= filters.sort === 'latest' ? 'selected' : '' %>>नवीन आधी</option>
          <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>लोकप्रिय आधी</option>
        </select>

        <button class="btn btn-primary" type="submit">लागू करा</button>
        <% if (filters.q || filters.category || filters.language || filters.type) { %>
          <a class="btn btn-ghost" href="<%= basePath %>">रीसेट</a>
        <% } %>
      </form>
    </div>

    <% if (posts.length) { %>
      <div class="grid grid-3">
        <% posts.forEach(function (post) { %>
          <%- include('../partials/post-card', { post: post }) %>
        <% }) %>
      </div>
      <%- include('../partials/pagination') %>
    <% } else { %>
      <div class="empty">
        <div class="empty-icon">✍️</div>
        <h3>अजून काही सापडले नाही</h3>
        <p>कृपया दुसरा शोध शब्द किंवा विभाग निवडा.</p>
        <a class="btn btn-primary" href="<%= basePath %>">सर्व पहा</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/public-footer') %>
