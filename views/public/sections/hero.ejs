<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="hero-kicker">मराठी साहित्य · गझल · अहिराणी</span>
      <h1 class="hero-title">डॉ. सदाशिव<br><span class="accent">सुर्यवंशी</span></h1>
      <p class="hero-name-en">Prof. Dr. Sadashiv Shriram Suryawanshi</p>
      <p class="hero-sub">
        धुळे येथील मराठी लेखक, गझलकार आणि अहिराणी भाषा-चळवळीतील कार्यकर्ते.
        खान्देश साहित्य संघाचे राष्ट्रीय अध्यक्ष. खान्देशातील मराठी, अहिराणी आणि
        इतर बोलीभाषांतील साहित्यिकांना व्यासपीठ देण्यासाठी कार्यरत.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/writings">साहित्य वाचा</a>
        <a class="btn btn-ghost" href="/about">परिचय जाणून घ्या</a>
        <a class="btn btn-ghost" href="/register">लेखक व्हा</a>
      </div>
      <blockquote class="hero-quote"><%= settings['home.quote'] %></blockquote>
    </div>

    <div class="hero-portrait">
      <div class="portrait-frame">
        <img src="/images/dada.jpg" alt="प्रा. डॉ. सदाशिव श्रीराम सुर्यवंशी" width="360" height="450" fetchpriority="high">
      </div>
      <span class="portrait-badge">खान्देश साहित्य संघ · राष्ट्रीय अध्यक्ष</span>
    </div>
  </div>
</section>
