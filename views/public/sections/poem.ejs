<% if (poem) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">कविता</span>
        <h2>शब्दांची राणी</h2>
      </div>
      <a class="section-link" href="/writings?type=poem">सर्व कविता</a>
    </div>
    <article class="poem-card">
      <div class="prose"><%- poem.body_html %></div>
      <div class="meta">
        <span class="badge badge-poem">कविता</span>
        <% if (poem.language === 'ahr') { %><span class="badge badge-ahr">अहिराणी</span><% } %>
        <span><%= poem.author_pen_name || poem.author_name %></span>
        <span class="dot"></span>
        <span><%= helpers.formatDateMr(poem.published_at) %></span>
      </div>
      <p class="mt-2"><a class="btn btn-ghost btn-sm" href="/writings/<%= poem.slug %>">पूर्ण कविता वाचा</a></p>
    </article>
  </div>
</section>
<% } %>
