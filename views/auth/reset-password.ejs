<%- include('../partials/public-header') %>

<section class="auth-wrap">
  <div class="auth-card form-card">
    <h1>नवीन पासवर्ड</h1>
    <p class="sub">किमान ८ अक्षरे, अक्षर आणि अंक आवश्यक.</p>

    <form action="/reset-password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">
      <div class="field">
        <label for="reset-password">नवीन पासवर्ड</label>
        <input class="input" id="reset-password" type="password" name="password" required minlength="8" autocomplete="new-password" autofocus>
        <% if (errors.password) { %><p class="error-text"><%= errors.password %></p><% } %>
      </div>
      <div class="field">
        <label for="reset-confirm">पासवर्ड पुन्हा</label>
        <input class="input" id="reset-confirm" type="password" name="confirm" required minlength="8" autocomplete="new-password">
        <% if (errors.confirm) { %><p class="error-text"><%= errors.confirm %></p><% } %>
      </div>
      <button class="btn btn-primary btn-block" type="submit">पासवर्ड बदला</button>
    </form>
  </div>
</section>

<%- include('../partials/public-footer') %>
