<%- include('../partials/public-header') %>

<section class="auth-wrap">
  <div class="auth-card form-card">
    <h1>पासवर्ड विसरला?</h1>
    <p class="sub">तुमचा नोंदणीकृत ईमेल टाका. रीसेट दुवा पाठवला जाईल.</p>

    <form action="/forgot-password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="forgot-email">ईमेल</label>
        <input class="input" id="forgot-email" type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email" autofocus>
        <% if (errors.email) { %><p class="error-text"><%= errors.email %></p><% } %>
      </div>
      <button class="btn btn-primary btn-block" type="submit">रीसेट दुवा पाठवा</button>
    </form>

    <p class="auth-footer"><a href="/login">← प्रवेशाकडे परत</a></p>
  </div>
</section>

<%- include('../partials/public-footer') %>
