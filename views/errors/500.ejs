<!doctype html>
<html lang="mr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>त्रुटी — <%= typeof status !== 'undefined' && status ? status : 500 %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main class="auth-wrap">
    <div class="auth-card form-card center">
      <div class="empty-icon" style="font-size:3.4rem;">⚠️</div>
      <h1 style="font-size:clamp(2.4rem,8vw,4rem);margin:0;color:var(--brand);"><%= typeof status !== 'undefined' && status ? status : '५००' %></h1>
      <h2 style="margin:0.3rem 0 0.6rem;">काहीतरी चूक झाली</h2>
      <p class="muted"><%= typeof message !== 'undefined' && message ? message : 'सर्व्हरवर काहीतरी चूक झाली. कृपया पुन्हा प्रयत्न करा.' %></p>
      <div class="flex gap-1" style="justify-content:center;flex-wrap:wrap;">
        <a class="btn btn-primary" href="/">मुख्यपृष्ठावर जा</a>
        <button class="btn btn-ghost" type="button" onclick="history.back()">मागे जा</button>
      </div>
    </div>
  </main>
</body>
</html>
