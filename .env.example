# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# A long random string (32+ characters). Change this in production.
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────
# Leave empty to use the local SQLite file at data/app.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Image storage (optional in dev, recommended in production) ──
# If these are empty, uploads are stored in public/uploads (local only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# ── Email (optional) ─────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
OWNER_EMAIL=owner@example.com

# ── Seed owner account ───────────────────────────────
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=Owner@12345

# ── Uploads ──────────────────────────────────────────
MAX_UPLOAD_MB=5
